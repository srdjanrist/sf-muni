{
  "name": "muni-live",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "dev": "concurrently -k -n server,web -c green,cyan \"tsx watch src/server/index.ts\" \"vite --host 127.0.0.1\"",
    "build": "npm run typecheck && vite build && tsc -p tsconfig.server.json",
    "build:web": "npm run typecheck && vite build",
    "build:server": "tsc -p tsconfig.server.json",
    "start": "node dist/server/server/index.js",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "test:production": "node --import tsx scripts/verify-production.ts",
    "test:live": "node --import tsx scripts/verify-live.ts",
    "format:check": "prettier --check src scripts tests *.ts *.json *.js",
    "gtfs:download": "tsx scripts/transit.ts download",
    "gtfs:parse": "tsx scripts/transit.ts parse",
    "map:prepare": "tsx scripts/prepare-map.ts",
    "transit:record-fixture": "tsx scripts/transit.ts record"
  },
  "dependencies": {
    "@fastify/compress": "^9.2.0",
    "@fastify/cors": "^11.3.0",
    "@fastify/static": "^10.1.3",
    "@js-temporal/polyfill": "^0.5.1",
    "@tanstack/react-query": "^5.102.8",
    "csv-parse": "^7.0.2",
    "dotenv": "^17.4.2",
    "fastify": "^5.12.3",
    "gtfs-realtime-bindings": "^2.2.0",
    "lucide-react": "^1.43.0",
    "maplibre-gl": "^6.8.0",
    "pmtiles": "^4.5.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "three": "^0.186.0",
    "unzipper": "^0.12.5",
    "zod": "^4.5.4",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.63.0",
    "@types/node": "^26.5.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@types/three": "^0.185.4",
    "@types/unzipper": "^0.10.11",
    "@vitejs/plugin-react": "^6.1.1",
    "concurrently": "^10.0.5",
    "eslint": "^10.10.0",
    "prettier": "^3.9.6",
    "tsx": "^4.23.13",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.70.0",
    "vite": "^8.2.2",
    "vitest": "^5.0.0"
  }
}
