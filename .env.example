# Server only. Never prefix the 511 key with VITE_.
511_API_KEY=
511_OPERATOR_ID=SF
# auto uses live only when a key is configured; fixture is visibly labeled.
TRANSIT_DATA_SOURCE=auto
FIXTURE_SCENARIO=synthetic
GTFS_REFRESH_INTERVAL_MS=86400000
VEHICLE_POLL_INTERVAL_MS=120000
TRIP_UPDATE_POLL_INTERVAL_MS=180000
SERVICE_ALERT_POLL_INTERVAL_MS=600000
API_REQUESTS_PER_HOUR=60
UPSTREAM_TIMEOUT_MS=30000
STATIC_DOWNLOAD_TIMEOUT_MS=120000
VEHICLE_STALE_AFTER_MS=180000
VEHICLE_REMOVE_AFTER_MS=600000
LOG_LEVEL=info
PORT=3001
HOST=127.0.0.1
DATA_DIR=data
SERVE_FRONTEND=true
# Exact frontend origins, comma-separated. No wildcard or trailing slash.
CORS_ORIGINS=
# Public backend origin for a separate frontend deployment; empty uses the local proxy.
VITE_API_ORIGIN=
VITE_TRANSIT_DEBUG=false
