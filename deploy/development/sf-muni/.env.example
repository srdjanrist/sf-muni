# Prefix can change later; point this hostname to the development VPS.
API_DOMAIN=sf-muni-api.tempserver.click
MUNI_IMAGE=ghcr.io/srdjanrist/sf-muni-api:latest
# Use your actual stable production Vercel URL, no trailing slash.
# Add specific preview URLs separated by commas only when needed.
CORS_ORIGINS=https://your-muni-project.vercel.app

# Runtime secret on the VPS only. Never commit .env or pass this to Docker build.
511_API_KEY=
511_OPERATOR_ID=SF
GTFS_REFRESH_INTERVAL_MS=86400000
VEHICLE_POLL_INTERVAL_MS=120000
TRIP_UPDATE_POLL_INTERVAL_MS=180000
SERVICE_ALERT_POLL_INTERVAL_MS=600000
API_REQUESTS_PER_HOUR=60
UPSTREAM_TIMEOUT_MS=30000
STATIC_DOWNLOAD_TIMEOUT_MS=120000
VEHICLE_STALE_AFTER_MS=180000
VEHICLE_REMOVE_AFTER_MS=600000
LOG_LEVEL=info
